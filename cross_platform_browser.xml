<?xml version="1.0" encoding="UTF-8"?>

<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">

<suite name="Cross Platform Browser Suite"
       parallel="tests"
       thread-count="18">

    <listeners>
        <listener class-name="utilities.ExtentReportUtility"/>
    </listeners>

    <!-- WINDOWS CHROME -->
    <test name="Windows Chrome">
        <parameter name="os" value="windows"/>
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="testCases.TC001_AccountRegistrationTest"/>
            <class name="testCases.TC002_LoginTest"/>
            <class name="testCases.TC003_LoginDDT"/>
            <class name="testCases.TC004_BrowseAndAddProducts"/>
        </classes>
    </test>

    <!-- WINDOWS FIREFOX -->
    <test name="Windows Firefox">
        <parameter name="os" value="windows"/>
        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="testCases.TC001_AccountRegistrationTest"/>
            <class name="testCases.TC002_LoginTest"/>
            <class name="testCases.TC003_LoginDDT"/>
            <class name="testCases.TC004_BrowseAndAddProducts"/>
        </classes>
    </test>

    <!-- WINDOWS EDGE -->
    <test name="Windows Edge">
        <parameter name="os" value="windows"/>
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="testCases.TC001_AccountRegistrationTest"/>
            <class name="testCases.TC002_LoginTest"/>
            <class name="testCases.TC003_LoginDDT"/>
            <class name="testCases.TC004_BrowseAndAddProducts"/>
        </classes>
    </test>

    <!-- LINUX CHROME -->
    <test name="Linux Chrome">
        <parameter name="os" value="linux"/>
        <parameter name="browser" value="chrome"/>

        <classes>
            <class name="testCases.TC001_AccountRegistrationTest"/>
            <class name="testCases.TC002_LoginTest"/>
            <class name="testCases.TC003_LoginDDT"/>
            <class name="testCases.TC004_BrowseAndAddProducts"/>
        </classes>
    </test>

    <!-- LINUX FIREFOX -->
    <test name="Linux Firefox">
        <parameter name="os" value="linux"/>
        <parameter name="browser" value="firefox"/>

        <classes>
            <class name="testCases.TC001_AccountRegistrationTest"/>
            <class name="testCases.TC002_LoginTest"/>
            <class name="testCases.TC003_LoginDDT"/>
            <class name="testCases.TC004_BrowseAndAddProducts"/>
        </classes>
    </test>

    <!-- LINUX EDGE -->
    <test name="Linux Edge">
        <parameter name="os" value="linux"/>
        <parameter name="browser" value="edge"/>

        <classes>
            <class name="testCases.TC001_AccountRegistrationTest"/>
            <class name="testCases.TC002_LoginTest"/>
            <class name="testCases.TC003_LoginDDT"/>
            <class name="testCases.TC004_BrowseAndAddProducts"/>
        </classes>
    </test>

</suite>